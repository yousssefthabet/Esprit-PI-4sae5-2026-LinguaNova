pipeline {
    agent any

    stages {
        stage('CI: Debug files') {
            steps {
                dir('backend/microservices/clubs-service') {
                    sh '''
                        pwd
                        ls -la
                    '''
                }
            }
        }

        stage('CI: Build & Test Clubs Service') {
            steps {
                dir('backend/microservices/clubs-service') {
                    sh '''
                        chmod +x mvnw
                        ./mvnw clean test
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Clubs service CI réussi. Déclenchement du CD..."
            build job: 'clubs-service-cd', wait: false
        }
    }
}