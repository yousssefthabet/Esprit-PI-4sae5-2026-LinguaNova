pipeline {
    agent any

    environment {
        APP_NAME = 'CI-Examen-Service'
    }

    stages {
        stage('CI: Clean') {
            steps {
                dir('backend/microservices/examen-service') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean'
                }
            }
        }

        stage('CI: Build') {
            steps {
                dir('backend/microservices/examen-service') {
                    sh './mvnw compile'
                }
            }
        }

        stage('CI: Unit Tests & Coverage') {
            steps {
                dir('backend/microservices/examen-service') {
                    sh '''
                        ./mvnw test jacoco:report \
                        -Dspring.datasource.url=jdbc:mysql://host.docker.internal:3306/linguanova \
                        -Dspring.datasource.username=root \
                        -Dspring.datasource.password=root \
                        -Dspring.jpa.hibernate.ddl-auto=update \
                        -Deureka.client.enabled=false \
                        -Dspring.cloud.config.enabled=false
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    dir('backend/microservices/examen-service') {
                        sh """
                            ./mvnw sonar:sonar \
                                -Dsonar.projectKey=${APP_NAME} \
                                -Dsonar.projectName=${APP_NAME} \
                                -Dsonar.host.url=http://host.docker.internal:9000 \
                                -Dsonar.token=${SONAR_TOKEN} \
                                -Dsonar.java.coveragePlugin=jacoco \
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Qualité validée ! Déclenchement du CD Examen..."
            build job: 'CD-Examen-Service', wait: false
        }
    }
}
