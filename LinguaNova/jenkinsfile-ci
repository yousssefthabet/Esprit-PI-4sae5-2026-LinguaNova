pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        CI = 'true'
    }

    stages {

        stage('CI: Install') {
            steps {
                dir('LinguaNova') {
                    sh 'npm install'
                }
            }
        }

        stage('CI: Build') {
            steps {
                dir('LinguaNova') {
                    sh 'npm run build'
                }
            }
        }

        stage('CI: Test') {
            steps {
                dir('LinguaNova') {
                    sh 'npm test -- --run'
                }
            }
        }
    }

    post {
        success {
            echo "✅ Build & Test Angular réussis. Déclenchement du CD..."
            build job: 'CD-Frontend', wait: false
        }
    }
}
