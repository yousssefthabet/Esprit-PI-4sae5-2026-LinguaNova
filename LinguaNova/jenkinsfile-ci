pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        CI = 'true'
    }

    stages {

        stage('CI: Install') {
            steps {
                dir('LinguaNova') {
                    sh 'npm install'
                }
            }
        }

        stage('CI: Build') {
            steps {
                dir('LinguaNova') {
                    sh 'npm run build'
                }
            }
        }

        stage('CI: Test') {
            steps {
                dir('LinguaNova') {
                    echo 'Frontend tests skipped'
                }
            }
        }
    }

    post {
        always {
            echo "🚀 Déclenchement CD Front..."
            build job: 'CD-Frontend', wait: false
        }
    }
}