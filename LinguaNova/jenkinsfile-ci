pipeline {
    agent any

    stages {
        stage('CI: Debug files') {
            steps {
                dir('LinguaNova') {
                    sh '''
                        pwd
                        ls -la
                        ls -la package.json package-lock.json
                    '''
                }
            }
        }

        stage('CI: Install & Build') {
            steps {
                dir('LinguaNova') {
                    sh '''
                        docker run --rm \
                        -v "$(pwd)":/app \
                        -w /app \
                        node:24-alpine \
                        sh -c "ls -la && npm ci && npm run build"
                    '''
                }
            }
        }

        stage('CI: Test') {
            steps {
                dir('LinguaNova') {
                    sh '''
                        docker run --rm \
                        -v "$(pwd)":/app \
                        -w /app \
                        node:24-alpine \
                        sh -c "npm test -- --no-watch --no-progress"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Build & Test Angular réussis. Déclenchement du CD..."
            build job: 'CD-Frontend', wait: false
        }
    }
}
