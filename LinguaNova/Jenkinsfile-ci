pipeline {
    agent any
    environment {
        CI = 'true'
    }
    stages {
        stage('CI: Install & Build') {
            steps {
                dir('LinguaNova') {
                    sh '''
                        docker run --rm -v "$PWD":/app -w /app node:24-alpine sh -c "npm ci && npm run build"
                    '''
                }
            }
        }
        stage('CI: Test') {
            steps {
                dir('LinguaNova') {
                    sh '''
                        docker run --rm -v "$PWD":/app -w /app node:24-bullseye-slim sh -c "apt-get update && apt-get install -y chromium && export CHROME_BIN=/usr/bin/chromium && npm test -- --no-watch --no-progress --browsers=ChromeHeadless"
                    '''
                }
            }
        }
    }
    post {
        success {
            echo "✅ Build & Test Angular réussis. Déclenchement du CD..."
            build job: 'CD-Frontend-LinguaNova', wait: false
        }
    }
}