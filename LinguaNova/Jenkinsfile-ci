pipeline {
    agent {
        docker {
            image 'cypress/browsers:node18.18.1-chrome118-ff120'
            args '--user root:root'
        }
    }
    environment {
        CI = 'true'
    }
    stages {
        stage('CI: Install & Build') {
            steps {
                dir('LinguaNova') {
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }
        stage('CI: Test') {
            steps {
                dir('LinguaNova') {
                    sh 'npm test -- --no-watch --no-progress --browsers=ChromeHeadless'
                }
            }
        }
    }
    post {
        success {
            echo "✅ Build & Test Angular réussis. Déclenchement du CD..."
            build job: 'CD-Frontend-LinguaNova', wait: false
        }
    }
}