pipeline {
    agent any
    environment {
        CI = 'true'
    }
    stages {
        stage('CI: Install & Build') {
            steps {
                dir('LinguaNova') {
                    script {
                        docker.image('node:18-alpine').inside('--user root:root') {
                            sh 'npm install'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }
        stage('CI: Test') {
            steps {
                dir('LinguaNova') {
                    script {
                        docker.image('cypress/browsers:node18.18.1-chrome118-ff120').inside('--user root:root') {
                            sh 'npm test -- --no-watch --no-progress --browsers=ChromeHeadless'
                        }
                    }
                }
            }
        }
    }
    post {
        success {
            echo "✅ Build & Test Angular réussis. Déclenchement du CD..."
            build job: 'CD-Frontend-LinguaNova', wait: false
        }
    }
}