pipeline {
    agent any
    environment {
        DOCKER_HUB_USER = 'mohamedsaidneffati'
        CREDENTIALS_ID = 'dockerhub-credentials'
        IMAGE_FRONT = "${DOCKER_HUB_USER}/linguanova-frontend"
        IMAGE_TAG = "1.0.${BUILD_NUMBER}"
    }
    stages {
        stage('CD: Push Front to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.CREDENTIALS_ID, passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                    sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'

                    dir('LinguaNova') {
                        sh "docker build -t ${IMAGE_FRONT}:${IMAGE_TAG} -t ${IMAGE_FRONT}:latest ."
                        sh "docker push ${IMAGE_FRONT}:${IMAGE_TAG}"
                        sh "docker push ${IMAGE_FRONT}:latest"
                    }
                }
            }
        }
    }
    post {
        always {
            sh 'docker logout'
            cleanWs()
        }
    }
}
